// Zvizzer — Calculadora de Eficiência de Polimento
// Dev local: SQLite (sem dependência externa). Produção: trocar o datasource
// para "postgresql" e apontar DATABASE_URL para o projeto Supabase — o schema
// abaixo foi desenhado para migrar sem alterações estruturais (sem tipos
// específicos de SQLite; valores monetários em Float, compatível com ambos).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

/// Parâmetros do "processo padrão Zvizzer", editáveis apenas pelo admin.
/// Singleton: sempre um único registro com id = "default".
model ZvizzerSettings {
  id                     String   @id @default("default")
  compostoNome           String   @default("Composto Zvizzer") // nome/linha do produto, para a tabela comparativa
  compostoPreco          Float // preço da embalagem do composto (R$)
  compostoPesoG          Float // peso da embalagem (g)
  compostoConsumoG       Float // consumo médio por carro (g)
  boinaNome              String   @default("Boina Zvizzer") // nome/linha do produto, para a tabela comparativa
  boinaPreco             Float // preço de cada boina (R$)
  boinaQuantidade        Float // qtd de boinas em revezamento
  boinaDurabilidadeCarros Float // carros atendidos antes da troca
  tempoProcessoMinutos   Float // tempo médio do processo Zvizzer (min), para 1 pessoa trabalhando sozinha
  updatedAt              DateTime @updatedAt
  updatedBy              String?
}

/// Parâmetros usados para transformar o custo fixo mensal informado pelo
/// usuário em custo-hora da operação. Singleton: sempre um único registro
/// com id = "default". Nunca hardcoded no client.
model LaborSettings {
  id                String   @id @default("default")
  /// Divisor de horas/mês (custo_hora = custo_fixo_mensal / horasBaseMensais).
  /// Referência padrão de mercado: 220h/mês.
  horasBaseMensais  Float    @default(220)
  updatedAt         DateTime @updatedAt
}

/// Master Trainers apresentados no fim do resultado. Nome, foto e mini-CV
/// são editáveis no painel admin (nada hardcoded no código).
model MasterTrainer {
  id        String   @id @default(cuid())
  nome      String
  fotoUrl   String? // caminho em /public/master-trainers/... ou URL externa
  miniCv    String // até ~4 linhas
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Contato deixado voluntariamente no fim do resultado, junto com um retrato
/// do cálculo daquela pessoa ("receba esse formulário com a sua realidade").
/// Preenchimento é opcional — o usuário segue para os revendedores de todo jeito.
model Lead {
  id       String @id @default(cuid())
  email    String
  whatsapp String

  // Retrato do resultado no momento do envio
  polimentosMes        Int
  custoAtualPorCarro   Float
  custoZvizzerPorCarro Float
  economiaMensal       Float
  horasLiberadasMes    Float

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Reseller {
  id        String   @id @default(cuid())
  nome      String
  cidade    String
  estado    String // sigla UF (ex.: SP, RJ)
  whatsapp  String // formato E.164 sem símbolos, ex.: 5511999999999
  /// Coordenadas para o pino no mapa. Preenchidas no admin (há um botão que
  /// busca automaticamente a partir de cidade + estado).
  latitude  Float?
  longitude Float?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clicks AnalyticsEvent[]

  @@index([estado, cidade])
}

/// Uma "sessão" anônima de uso da calculadora (sem login, sem PII).
model AnalyticsSession {
  sessionId           String   @id
  createdAt           DateTime @default(now())
  completedCalculation Boolean @default(false)
  whatsappClicked     Boolean @default(false)

  events AnalyticsEvent[]
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  sessionId  String
  session    AnalyticsSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  eventName  String
  step       Int?
  resellerId String?
  reseller   Reseller? @relation(fields: [resellerId], references: [id])
  estado     String?
  cidade     String?
  timestamp  DateTime @default(now())

  @@index([eventName])
  @@index([sessionId])
}
