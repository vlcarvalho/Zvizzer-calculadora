# Dev local: SQLite (arquivo em prisma/dev.db). Em produção, trocar por uma
# connection string do Supabase (postgresql://...) e mudar o provider no
# schema.prisma para "postgresql".
DATABASE_URL="file:./dev.db"

# Sessão do admin (JWT em cookie httpOnly). Gerar um valor forte em produção:
# `openssl rand -base64 32`
AUTH_SECRET="COLE_UM_SEGREDO_FORTE_AQUI"

# Usado apenas pelo script prisma/seed-admin.ts para criar o admin inicial
ADMIN_EMAIL="admin@zvizzer.com.br"
ADMIN_PASSWORD="defina-uma-senha-forte"
